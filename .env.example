# Backend - FastAPI

# Secret key used to sign JWT access tokens.
SECRET_KEY=your-secret-key-here

# JWT signing algorithm.
ALGORITHM=HS256

# Number of minutes before an access token expires.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database connection URL used by SQLAlchemy.
DATABASE_URL=sqlite:///./supportsync.db

# Comma-separated origins allowed to access the API from the browser.
ALLOWED_ORIGINS=http://localhost:5173

# Directory where uploaded files are stored.
UPLOAD_DIR=uploads

# Maximum allowed uploaded file size in megabytes.
MAX_FILE_SIZE_MB=10

# Seed admin email used for local development account setup.
ADMIN_EMAIL=admin@example.com

# Seed admin password used for local development account setup.
ADMIN_PASSWORD=change-this-admin-password

# Frontend - Vite

# Base URL used by the React app when calling the FastAPI backend.
VITE_API_BASE_URL=https://supportsync-production.up.railway.app
